# Virtualenv / caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.pytest-*/
.pytest_tmp*/
pytest_tmp/
tests_tmp/

# Runtime state, queues, locks
*.db
*.db-wal
*.db-shm
*.lock
*.pid
antigravity/messages/
**/replay_store.db*

# Credentials / secrets
agent_keys.json
antigravity/config/telegram_config.json
antigravity/config/dhan_config.json
*.token
.env

# Large binary data
"data screenshots"/
*.pb

# Live broker session credentials (Zerodha enctoken harvested from Chrome)
shared/live_depth.json
shared/track2_liquid/live_depth_track2.json
antigravity/logs/live_depth_ticks.csv

# Local scratch and OS metadata
scratch/
desktop.ini

# Track 2 research data and outputs: generated, never committed (execution plan rule 1.2.6)
shared/track2_liquid/history/
research/outputs/
# Pre-registration locks must be committed (plan P7.3), despite the global *.lock rule above
!research/studies/prereg/*.lock
